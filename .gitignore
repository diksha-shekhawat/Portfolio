# ============================================================
# .gitignore — Files and folders Git should NEVER track
# ============================================================

# ── Node.js dependencies ──
node_modules/

# ── Environment files — NEVER push these! ──
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# ── React build output ──
frontend/build/

# ── OS generated files ──
.DS_Store
Thumbs.db

# ── Editor settings ──
.vscode/
.idea/

# ── Log files ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
